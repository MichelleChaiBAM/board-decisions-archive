generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Subject {
  id        String     @id @default(cuid())
  name      String     @unique
  decisions Decision[]
}

model Decision {
  id            String       @id @default(cuid())
  decisionDate  DateTime
  title         String
  keywords      String
  description   String       @db.Text
  customSubject String?
  createdBy     String       @default("michelle.c@bam.org.my")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  subjects      Subject[]
  attachments   Attachment[]

  @@index([decisionDate])
  @@index([createdBy])
}

model Attachment {
  id         String   @id @default(cuid())
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  createdAt  DateTime @default(now())

  @@index([decisionId])
}
